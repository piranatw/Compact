# Postgres connection strings from your Supabase project (Project Settings ->
# Database -> Connection string). DATABASE_URL is the pooled/pgbouncer
# connection (port 6543, add "?pgbouncer=true") used at runtime by serverless
# functions; DIRECT_URL is the direct connection (port 5432) used only for
# `prisma migrate`. Both point at the same database.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Session signing secret (JWT). Generate a real random value for anything beyond
# local dev, e.g.: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# The single provisioned owner account. Used only by prisma/seed.ts to create
# the owner row; change the password after first sign-in is not supported yet,
# so pick something real before seeding a non-local database.
OWNER_EMAIL="you@example.com"
OWNER_PASSWORD="change-me"

# Shared secret the reminders scheduler (Supabase Cron in production, or
# scripts/scheduler.ts locally) must present via the x-scheduler-secret header
# when calling POST /api/jobs/reminders. Generate with: openssl rand -hex 32
SCHEDULER_SECRET="change-me-to-a-random-scheduler-secret"

# Web Push VAPID keypair. Generate your own with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is intentionally public and is also exposed to the browser as
# NEXT_PUBLIC_VAPID_PUBLIC_KEY. Never commit a real private key.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
